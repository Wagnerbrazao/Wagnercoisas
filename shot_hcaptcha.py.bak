"""
Conecta no CHROME REAL da máquina (via CDP), preenche CPF e data de
nascimento, resolve o hCaptcha automaticamente via NoneCap API, envia a
consulta e espera chegar no "Comprovante de Situação Cadastral no CPF".

Como rodar:
  1. venv/bin/python Captcha/iniciar_chrome.py   (abre SEU Chrome com CDP)
  2. venv/bin/python Captcha/shot_playwright.py
"""

import os
import sys
import time
import urllib.request

from nonecap import NoneCap, SolveFailedError, SolveTimeoutError
from playwright.sync_api import sync_playwright

CPF = "04243259186"
DATA_NASCIMENTO = "27052008"
URL = "https://servicos.receita.fazenda.gov.br/Servicos/CPF/ConsultaSituacao/ConsultaPublica.asp"
CDP_URL = "http://127.0.0.1:9222"
NONECAP_KEY = os.environ.get("NONECAP_KEY", "nc_live_D59LBmzuYDfwGZeOjoA30ZqlDXmoB1EA")


def main():
    try:
        urllib.request.urlopen(CDP_URL + "/json/version", timeout=1)
    except Exception:
        print("[!] Chrome real não está com CDP ativo.")
        print("    Rode:  venv/bin/python Captcha/iniciar_chrome.py")
        return

    nc = NoneCap(api_key=NONECAP_KEY)

    with sync_playwright() as p:
        browser = p.chromium.connect_over_cdp(CDP_URL)
        ctx = browser.contexts[0]

        page = None
        for pg in ctx.pages:
            if "servicos.receita.fazenda.gov.br" in pg.url:
                page = pg
                break
        if page is None:
            page = ctx.pages[0] if ctx.pages else ctx.new_page()

        print("[+] Conectado no SEU Chrome.")
        page.bring_to_front()
        page.goto(URL, wait_until="domcontentloaded")
        time.sleep(2)

        print("[+] Preenchendo CPF e Data de Nascimento...")
        page.fill("#txtCPF", CPF)
        page.evaluate("() => document.getElementById('txtCPF').blur()")
        page.fill("#txtDataNascimento", DATA_NASCIMENTO)
        page.evaluate("() => document.getElementById('txtDataNascimento').blur()")
        time.sleep(1)
        page.screenshot(path="/tmp/rf_01_preenchido.png")
        print("[shot] /tmp/rf_01_preenchido.png")

        # ===== lê o sitekey do hCaptcha na página =====
        sitekey = page.evaluate("""() => {
            var el = document.querySelector('[data-sitekey]');
            if (el) return el.getAttribute('data-sitekey');
            var scripts = document.querySelectorAll('script[src*="hcaptcha.com/1/api.js"]');
            for (var s of scripts) {
                var m = s.src.match(/sitekey=([^&]+)/);
                if (m) return decodeURIComponent(m[1]);
            }
            return null;
        }""")
        if not sitekey:
            print("[-] sitekey do hCaptcha não encontrada na página.")
            return
        print("[+] sitekey:", sitekey)

        # ===== resolve o hCaptcha via NoneCap =====
        print("[+] Resolvendo hCaptcha via NoneCap...")
        try:
            solve = nc.solve(type="hcaptcha", sitekey=sitekey, url=URL)
            token = solve.token
            print("[+] Token obtido! (%d caracteres)" % len(token))
        except SolveFailedError as e:
            print("[-] NoneCap falhou:", e.solve.error.code)
            return
        except SolveTimeoutError:
            print("[-] NoneCap timeout (>180s). Tente novamente.")
            return
        except Exception as e:
            print("[-] Erro NoneCap:", e)
            return

        # ===== injeta o token na página =====
        page.evaluate(r"""(token) => {
            var ta = document.querySelector("textarea[name='h-captcha-response']");
            if (ta) ta.value = token;
            var chk = document.getElementsByName("idCheckedReCaptcha")[0];
            if (chk) chk.value = "true";
            var alvo = document.getElementById("h-recaptcha-response");
            if (!alvo) {
                alvo = document.createElement("input");
                alvo.type = "hidden"; alvo.id = "h-recaptcha-response";
                alvo.name = "h-recaptcha-response";
                (document.getElementById("theForm") || document.body).appendChild(alvo);
            }
            alvo.value = token;
        }""", token)
        print("[+] Token injetado na página.")
        time.sleep(1)
        page.screenshot(path="/tmp/rf_02_token_injetado.png")
        print("[shot] /tmp/rf_02_token_injetado.png")

        # ===== clica em Consultar =====
        print("[+] Clicando em Consultar...")
        try:
            with page.expect_navigation(wait_until="domcontentloaded", timeout=30000):
                page.click("#id_submit")
        except Exception as e:
            print("[-] navegação:", e)
        time.sleep(2)

        # ===== espera o Comprovante de Situação Cadastral =====
        print("[+] Aguardando o Comprovante de Situação Cadastral...")
        alvo_ok = False
        try:
            page.wait_for_selector(
                "span.clTitulo3:has-text('Comprovante de Situação Cadastral no CPF')",
                timeout=30000,
            )
            alvo_ok = True
        except Exception:
            alvo_ok = False

        page.screenshot(path="/tmp/rf_03_resultado.png", full_page=True)
        print("[shot] /tmp/rf_03_resultado.png")
        if alvo_ok:
            print("=" * 60)
            print("RESULTADO: CHEGOU NO COMPROVANTE DE SITUAÇÃO CADASTRAL")
            print("=" * 60)
        else:
            print("RESULTADO: ? Comprovante não encontrado — verifique a tela.")

        print("\n[i] Navegador ABERTO — ele NÃO fecha sozinho.")
        if sys.stdin.isatty():
            input("    Pressione Enter AQUI no terminal para fechar o navegador...")
        else:
            print("    (sem terminal interativo — saindo sem fechar o navegador)")
            return
        ctx.close()
        print("[+] Fim.")


if __name__ == "__main__":
    main()