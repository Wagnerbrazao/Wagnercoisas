"""
Grava SEUS movimentos reais de mouse clicando no checkbox do hCaptcha.
Depois, o bot reproduz exatamente esse movimento (com pequenas variações).

NÃO precisa de teclado nem de terminal interativo: é só usar o mouse.

Como usar:
  1. Abra a página da Receita com o hCaptcha em uma janela do navegador.
  2. Rode:  venv/bin/python Captcha/gravar_movimento.py
  3. Movimente o mouse NATURALMENTE até o checkbox e clique UMA vez.
     Repita quantas vezes quiser — cada clique vira um arquivo em
     Captcha/movimentos/ (o bot sorteia um a cada execução).
  4. Ctrl+C no terminal para encerrar.
"""

import json
import os
import time
from datetime import datetime

import Xlib
import Xlib.display

PASTA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "movimentos")
BOTAO_1 = 1 << 8          # Button1Mask do X11 (botão esquerdo)
TAXA = 0.008              # ~120 amostras/segundo
JANELA = 6.0              # segundos de histórico mantidos antes do clique
POS_CLIQUE = 0.2          # segundos extras gravados depois de soltar o botão
MOVIMENTO_MINIMO = 60     # distância mínima (px) para a gravação valer
DURACAO_MINIMA = 0.2      # duração mínima (s) para a gravação valer


def salvar(dados):
    os.makedirs(PASTA, exist_ok=True)
    nome = "gravacao_%s.json" % datetime.now().strftime("%Y%m%d_%H%M%S_%f")
    caminho = os.path.join(PASTA, nome)
    with open(caminho, "w") as f:
        json.dump(dados, f)
    return caminho


def main():
    os.makedirs(PASTA, exist_ok=True)
    display = Xlib.display.Display()
    raiz = display.screen().root
    geometria = raiz.get_geometry()
    total = 0

    print("=" * 62)
    print("GRAVADOR DE MOVIMENTO DO MOUSE (hCaptcha)")
    print("  Apenas mova o mouse NATURALMENTE até o checkbox e clique.")
    print("  Cada clique vira um arquivo em: Captcha/movimentos/")
    print("  Ctrl+C para sair.")
    print("=" * 62)

    buffer = []       # (timestamp, x, y) — histórico rolante do cursor
    botao = False     # botão esquerdo pressionado?
    clique = None

    try:
        while True:
            p = raiz.query_pointer()
            agora = time.perf_counter()

            buffer.append((agora, p.root_x, p.root_y))
            corte = agora - JANELA
            while buffer and buffer[0][0] < corte:
                buffer.pop(0)

            # detecta pressionar / soltar do botão esquerdo
            if not botao and (p.mask & BOTAO_1):
                botao = True
                clique = {"x": p.root_x, "y": p.root_y, "inicio": agora}
                print("[+] Clique em (%d, %d)" % (p.root_x, p.root_y))
            if botao and clique and not (p.mask & BOTAO_1):
                clique["duracao"] = (agora - clique["inicio"]) * 1000
                soltou = agora
                # segue gravando um pouco após soltar
                while time.perf_counter() - soltou < POS_CLIQUE:
                    p2 = raiz.query_pointer()
                    t2 = time.perf_counter()
                    buffer.append((t2, p2.root_x, p2.root_y))
                    time.sleep(TAXA)

                amostras = [
                    ((t - buffer[0][0]) * 1000, x, y) for (t, x, y) in buffer
                ]
                if not amostras:
                    botao = False
                    clique = None
                    buffer = []
                    continue

                # remove a parte parada do início (mão "esperando" antes de partir)
                px0, py0 = amostras[0][1], amostras[0][2]
                while len(amostras) > 1 and \
                        (amostras[0][1] - px0) ** 2 + (amostras[0][2] - py0) ** 2 < 64:
                    amostras.pop(0)

                botao = False
                clique_bkp = clique
                clique = None
                buffer = []

                if len(amostras) < 5:
                    print("[-] Movimento curto demais — descartado. Tente de novo.")
                    continue
                dx = amostras[0][1] - clique_bkp["x"]
                dy = amostras[0][2] - clique_bkp["y"]
                if (dx * dx + dy * dy) ** 0.5 < MOVIMENTO_MINIMO:
                    print("[-] Você começou perto demais do checkbox — descartado.")
                    continue
                duracao = amostras[-1][0] - amostras[0][0]
                if duracao < DURACAO_MINIMA:
                    print("[-] Gravação muito rápida — descartada. Tente de novo.")
                    continue

                dados = {
                    "amostras": amostras,
                    "clique": clique_bkp,
                    "tela": {"largura": geometria.width, "altura": geometria.height},
                }
                caminho = salvar(dados)
                total += 1
                print("[+] Salvo: %s (%d amostras, %.2f s, clique %d ms) — total: %d"
                      % (os.path.basename(caminho), len(amostras), duracao,
                         clique_bkp["duracao"], total))
                print("    Ctrl+C para sair.")

            time.sleep(TAXA)
    except KeyboardInterrupt:
        pass
    finally:
        print("\n[+] Fim. Gravações salvas: %d em %s" % (total, PASTA))


if __name__ == "__main__":
    main()